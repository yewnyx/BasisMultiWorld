# Copy to .env and keep it private (chmod 600). Never commit it.
# docker compose reads this file too and treats "$" as a variable: wrap any value containing "$"
# in single quotes, for example UNLOCK_PASSWORD='pa$$word'.

# Upstream Basis commit, branch or tag the server is built from. Pin a commit, and bump it on purpose.
BASIS_REF=2f5b3e106ea10a1dc96b208d000428a335ef7c6c
# Commit of the WebSocket transport package (dooly123/Basis-TCP-Transport-Package) built into the server.
WEBSOCKET_REF=62a4468432eb82c78ac744a7e78fca4bb91f7c8a

# Where your .BEE world bundles are served from (no trailing slash), and the password they were
# built with. UNLOCK_PASSWORD_<SLUG> overrides it for one world (slug upper-cased, "-" becomes "_").
CDN_BASE=https://cdn.example.com/basis
UNLOCK_PASSWORD=
# UNLOCK_PASSWORD_FOREST=

# Your player DID(s), comma-separated. Seeded as admin on each world's FIRST boot only;
# use add-admin.sh to add admins later.
BASIS_FIRST_ADMIN=

# DNS names for dns-records.sh: the hub is DNS_ZONE itself, each world is <slug>.DNS_ZONE,
# and SRV records point at DNS_HOST.DNS_ZONE.
DNS_ZONE=worlds.example.com
DNS_HOST=vm1

# Web players (browsers), optional; see "Web players" in the tutorial. "yes" adds a Caddy TLS
# front on TCP 80, 443, 4296 and every world port, using the DNS names above.
WEB_PLAYERS=no
# Where you host the web client (on a CDN, not this server), for example https://play.worlds.example.com/.
# Opening a world's name in a browser then redirects there, set to join that world. Empty = no redirect.
WEB_CLIENT_URL=
# Subnet of the compose network. The worlds trust X-Forwarded-For only from it. Change it only if
# it collides with another network on the server, then run `sudo docker compose down` before `up`.
PROXY_NET=172.30.42.0/24

# Optional, per world (slug upper-cased): <SLUG>_PASSWORD (join password; empty = anyone can join),
# <SLUG>_PEER_LIMIT (default 64), <SLUG>_MOTD, and <SLUG>_API_KEY for the dashboard
# (generate with: openssl rand -hex 32; empty keeps the server's REST API off).
HUB_API_KEY=
FOREST_API_KEY=
CITY_API_KEY=
